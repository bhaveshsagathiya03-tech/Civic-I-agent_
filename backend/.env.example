APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./civic_i.db
MEDIA_DIR=./media
MAX_UPLOAD_MB=10
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-this-before-running
JWT_EXPIRY_MINUTES=720
# Set only after training/validating a two-class YOLO checkpoint:
YOLO_WEIGHTS=./models/civic_i_best.pt
YOLO_CONFIDENCE=0.35
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DUPLICATE_RADIUS_M=40
DUPLICATE_WINDOW_DAYS=30
